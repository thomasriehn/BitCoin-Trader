# /etc/freqtrade/secrets.env  (root:freqtrade, 0640)
# Wird nur von freqtrade.service (LIVE, Phase 4) gelesen. Vorher bleibt die Datei mit
# Platzhaltern liegen; install.sh startet freqtrade.service nie von selbst.
#
# Der Trade-Key "bot-live" (Scope View + Trade, IP-Whitelist, NIE Withdraw) wird erst in Phase 4
# angelegt. Bis dahin: Platzhalter stehen lassen.
#
# Freqtrade liest Variablen mit dem Muster FREQTRADE__<abschnitt>__<schluessel>. Die Werte unten
# überschreiben config.json und config-private.json, damit die Live-Instanz mit derselben
# Konfiguration wie der Dry-Run läuft, aber mit eigenem Key, eigenem Port und eigener DB
# (die DB kommt per --db-url aus der Unit).

# Trade-Key (View + Trade). Der View-only-Key aus config-private.json wird damit überschrieben.
FREQTRADE__EXCHANGE__KEY=BITVAVO_TRADE_KEY_PLACEHOLDER
FREQTRADE__EXCHANGE__SECRET=BITVAVO_TRADE_SECRET_PLACEHOLDER

# Live statt Dry-Run. Ohne diese Zeile handelt auch freqtrade.service nur simuliert.
FREQTRADE__DRY_RUN=false
# Eigener API-Port (der Dry-Run belegt 8080). FT_API_URL in btctrader.env dann auf 8081 stellen.
FREQTRADE__API_SERVER__LISTEN_PORT=8081
FREQTRADE__BOT_NAME=btctrend-live

# Eigener Telegram-Bot für die Live-Instanz (nie denselben Bot für zwei Instanzen).
# FREQTRADE__TELEGRAM__ENABLED=true
# FREQTRADE__TELEGRAM__TOKEN=
# FREQTRADE__TELEGRAM__CHAT_ID=
