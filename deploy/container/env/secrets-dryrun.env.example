# /etc/freqtrade/secrets-dryrun.env  (root:freqtrade, 0640)
# Wird nur von freqtrade-dryrun.service gelesen. Enthält ausschließlich den View-only-Key
# für den Dry-Run-Bot (Bitvavo-Key "bot-dryrun", Scope View, IP-Whitelist, kein Withdraw).
#
# Freqtrade liest Variablen mit dem Muster FREQTRADE__<abschnitt>__<schluessel> und überschreibt
# damit die Werte aus config.json und config-private.json. Du hast zwei gleichwertige Wege:
#   a) Key und Secret hier eintragen (diese Datei), config-private.json lässt "key"/"secret" leer.
#   b) Key und Secret in /srv/trading/user_data/config-private.json (0600) eintragen und die
#      beiden Zeilen hier auskommentiert lassen.
# Nicht beides: ein leerer Wert hier würde den Wert aus config-private.json überschreiben.
#
# Der Dry-Run sendet keine Orders. Der Key dient nur dazu, Bilanz und Markt zu lesen. Ein Key
# mit Scope Trade gehört hier NICHT hinein.

FREQTRADE__EXCHANGE__KEY=BITVAVO_VIEW_KEY_PLACEHOLDER
FREQTRADE__EXCHANGE__SECRET=BITVAVO_VIEW_SECRET_PLACEHOLDER

# Optional: eigener Telegram-Bot des Dry-Run-Bots, falls nicht in config-private.json.
# FREQTRADE__TELEGRAM__ENABLED=true
# FREQTRADE__TELEGRAM__TOKEN=
# FREQTRADE__TELEGRAM__CHAT_ID=
