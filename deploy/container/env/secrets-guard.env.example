# /etc/freqtrade/secrets-guard.env  (root:freqtrade, 0640)
# Wird nur von btctrader-guard.service gelesen (EnvironmentFile=-, die Datei darf fehlen).
# Enthält ausschließlich den Trade-Key für den börsenseitigen Dead-Man's-Switch
# (GUARD_COD_ENABLED=true in btctrader.env, Bitvavo cancelOrdersAfter). Erst in Phase 4 mit
# einer Mini-Position testen. Bis dahin bleiben die Werte leer.
#
# Warum eine eigene Datei: btctrader.env landet in der Umgebung aller Dienste, auch des
# Dashboards ohne Login und des Advisors. Ein Key mit Scope Trade gehört nur in den Guard.
# Der Guard liest zuerst die Prozessumgebung, dann diese Datei (GUARD_TRADE_ENV_FILE
# überschreibt den Pfad) und warnt, wenn er den Key noch in btctrader.env findet.
#
# Scope View + Trade, IP-Whitelist auf die statische IP, NIE Withdraw.

GUARD_TRADE_API_KEY=
GUARD_TRADE_API_SECRET=
