# /etc/freqtrade/btctrader.env  (root:freqtrade, 0640)
# Konfiguration der eigenen Dienste: advisor, ledger, guard, heartbeat, dashboard.
# Die Freqtrade-Units lesen diese Datei ebenfalls, damit die Strategien GUARD_DIR und
# ADVISOR_DIR kennen. Freqtrade selbst wertet nur Variablen mit dem Präfix FREQTRADE__ aus.
#
# Format: KEY=WERT, eine Zeile pro Variable, keine Leerzeichen um das "=".
# Werte mit Sonderzeichen in doppelte Anführungszeichen setzen. Zeilen mit # sind Kommentare.
# Beschreibung aller Variablen: docs/KOMPONENTEN.md, Abschnitt 3.
# Nach jeder Änderung: systemctl restart btctrader-dashboard.service (Timer lesen die Datei
# bei jedem Lauf neu) und bei GUARD_DIR/ADVISOR_DIR auch freqtrade-dryrun.service.

# ---- Freqtrade-REST-API des aktiven Bots ----------------------------------------------
# Dry-Run: Port 8080. Live (Phase 4): Port 8081. Der Guard bewacht den Bot, auf den FT_API_URL zeigt.
FT_API_URL=http://127.0.0.1:8080
# Pflicht. Muss zu api_server.username / api_server.password in config-private.json passen.
FT_API_USER=freqtrader
FT_API_PASS=CHANGE_ME_API_PASSWORD
# Freqtrade-DB für Abgleich und Dry-Run-Fills (Live: /srv/trading/user_data/tradesv3.sqlite).
FT_DB_PATH=/srv/trading/user_data/tradesv3.dryrun.sqlite

# ---- Bitvavo View-only-Key für Ledger (Fills, Bilanz) und Guard (Bilanzabgleich) ----------
# Scope nur "View", IP-Whitelist auf die statische IP, nie "Withdraw". Leer = nur Dry-Run-Quelle.
BITVAVO_API_KEY_RO=
BITVAVO_API_SECRET_RO=
# MiCA operatorId, wird bei ccxt-Aufrufen gesetzt (Integer, wie in config.json).
BITVAVO_OPERATOR_ID=1

# ---- Trade-Key für den Dead-Man's-Switch (GUARD_COD_ENABLED) gehört NICHT hierher ----------
# Diese Datei landet in der Umgebung aller Dienste, auch des Dashboards ohne Login. Der Guard
# liest GUARD_TRADE_API_KEY/GUARD_TRADE_API_SECRET aus /etc/freqtrade/secrets-guard.env
# (Vorlage deploy/container/env/secrets-guard.env.example), die nur btctrader-guard.service lädt.
# Optional: anderer Pfad für diese Datei (Default /etc/freqtrade/secrets-guard.env).
# GUARD_TRADE_ENV_FILE=/etc/freqtrade/secrets-guard.env

# ---- Ledger --------------------------------------------------------------------------
LEDGER_DB_PATH=/srv/trading/ledger/ledger.sqlite
# Wallet-Kennung für die walletbezogene FIFO (BMF Rn. 61/62).
LEDGER_ACCOUNT_ID=bitvavo-main
# freqtrade-db (Dry-Run) oder exchange (Live, braucht den RO-Key oben).
LEDGER_SOURCE=freqtrade-db
LEDGER_EXPORT_DIR=/srv/trading/ledger/exports
# Startkapital für die Benchmarks (B&H, DCA), in EUR.
START_CAPITAL_EUR=1000
# Pflicht: Tag 0 der Benchmarks (B&H, DCA) als ISO-Datum, der Tag, an dem der Dry-Run startet.
# Absichtlich ein Platzhalter: ein falsches Datum würde die Benchmarks still vom falschen Kurs
# rechnen. install.sh aktiviert nichts, solange er hier steht.
BENCHMARK_START=CHANGE_ME_YYYY-MM-DD
# Virtuelles DCA verteilt START_CAPITAL_EUR über so viele Wochen.
DCA_WEEKS=52
# Bitvavo Kategorie A Stufe 0. Der Ledger liest reale Gebühren aus den Fills, Benchmarks nutzen diese.
FEE_MAKER=0.0015
FEE_TAKER=0.0025

# ---- Advisor (lokales vLLM, docs/VLLM_ADVISOR.md) ---------------------------------------
# OpenAI-kompatible API des GPU-Hosts im LAN oder über Tailscale. Nie ein Cloud-LLM.
ADVISOR_BASE_URL=http://192.168.1.50:8000/v1
# Pflicht für "advisor run": Name wie in vLLM gestartet (--served-model-name, Default "advisor").
ADVISOR_MODEL=advisor
# Derselbe Wert wie VLLM_API_KEY in deploy/vllm/.env auf dem GPU-Host.
ADVISOR_API_KEY=
# shadow = nur loggen (Default, mindestens 6 Monate). gate = Strategie BtcAdvisorGated darf Entries blocken.
ADVISOR_MODE=shadow
# Erwarteter Abstand der Aufrufe in Stunden (Timer: stündlich). valid_until = Aufruf + 2 x Intervall.
ADVISOR_INTERVAL_HOURS=1
ADVISOR_DIR=/srv/trading/advisor
# HTTP-Timeout für den Modellaufruf in Sekunden.
ADVISOR_TIMEOUT_S=120

# ---- Guard ---------------------------------------------------------------------------
GUARD_DIR=/srv/trading/guard
# Tagesverlust in Prozent des Tagesstart-Equity, ab dem stopentry ausgelöst wird.
GUARD_DAILY_LOSS_PCT=3.0
# Drawdown vom Equity-Hoch in Prozent, ab dem alles glattgestellt und der Bot gestoppt wird (Kill-Switch).
GUARD_MAX_DRAWDOWN_PCT=20.0
# Erlaubte Abweichung Börsen-Bilanz vs. Freqtrade-Bilanz in EUR (nur Live mit RO-Key).
GUARD_RECONCILE_TOL_EUR=2.0
# Börsenseitiger Dead-Man's-Switch (cancelOrdersAfter) erneuern. Default aus, storniert auch Exit-Orders.
GUARD_COD_ENABLED=false
# Countdown für cancelOrdersAfter in Sekunden (10 bis 300).
GUARD_COD_SECONDS=120

# ---- Alarme und Heartbeat -------------------------------------------------------------
# Ping-URL von Healthchecks.io oder einer eigenen Instanz. Leer = kein Ping, nur Log.
HEALTHCHECKS_URL=
# Eigener Telegram-Bot für Alarme (nicht der Bot von Freqtrade). Leer = kein Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy-Topic, z. B. https://ntfy.example.com/btc-bot. Leer = kein ntfy.
NTFY_URL=

# ---- Dashboard -----------------------------------------------------------------------
# Bind-Adresse der Ergänzungsseite. Nur localhost, Zugriff über "tailscale serve".
DASHBOARD_BIND=127.0.0.1:8090
# Nur für die Anzeige. Alle gespeicherten Zeitstempel sind UTC.
TZ_DISPLAY=Europe/Berlin
