# Copy to .env next to docker-compose.yml and fill in. Never commit the real file.

# Model as Hugging Face ID (see docs/VLLM_ADVISOR.md for the hardware tiers).
VLLM_MODEL=Qwen/Qwen3-14B-AWQ
# Name the advisor uses in ADVISOR_MODEL. Keep "advisor" and you never need to touch btctrader.env when swapping models.
VLLM_SERVED_NAME=advisor

# Random string, at least 32 characters: openssl rand -hex 32. Same value goes into ADVISOR_API_KEY on the trading host.
# Compose only checks that the value is non-empty, so replace the placeholder before the first start.
VLLM_API_KEY=CHANGE_ME_LONG_RANDOM_STRING

# Image tag verified with this repo.
VLLM_IMAGE_TAG=v0.29.0

# Context window; the advisor prompt is about 5k tokens (Qwen tokenizers count every digit) plus 400 for the answer.
VLLM_MAX_MODEL_LEN=8192
VLLM_SEED=42
VLLM_GPU_MEM=0.90
VLLM_MAX_NUM_SEQS=4
VLLM_GPU_COUNT=1

# auto | xgrammar | guidance | outlines | lm-format-enforcer
VLLM_SO_BACKEND=auto
# qwen3 for Qwen3/Qwen3.5, deepseek_r1 for Magistral, leave as is otherwise (harmless when thinking is off)
VLLM_REASONING_PARSER=qwen3

# 127.0.0.1 keeps the port local (recommended); use the Tailscale IP of the GPU host if the bot runs elsewhere.
# Binding to the Tailscale IP fails at boot when tailscale0 is not up yet; see README.md ("Tailscale und Reboot").
VLLM_BIND=127.0.0.1
VLLM_PORT=8000

# Optional: HF token only for gated repos; the recommended models are not gated.
HF_TOKEN=
# Directory that keeps the downloaded weights between restarts.
HF_CACHE_DIR=~/.cache/huggingface
# Set to 1 after the first successful download to avoid hub calls at every start.
HF_HUB_OFFLINE=0
